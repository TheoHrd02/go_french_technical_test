# Cle API Anthropic — ne jamais committer la vraie valeur
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modele utilise pour la generation
MODEL=claude-sonnet-4-5

# Nombre maximum de tentatives (1 initiale + N-1 relances)
MAX_RETRIES=3

# Timeout par appel LLM, en millisecondes
REQUEST_TIMEOUT_MS=30000

# Port d'ecoute du serveur HTTP
PORT=3000
